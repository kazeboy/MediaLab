# Copy to .env and adjust. Every value is optional; defaults are shown.
# User preferences (FxTwitter fallback, max file size) are managed in the app's
# Settings panel and saved to settings.json. See "First-run values" below.

# Network binding. MediaLab refuses non-loopback hosts unless explicitly allowed.
MEDIALAB_HOST=127.0.0.1
MEDIALAB_PORT=8000
MEDIALAB_ALLOW_NON_LOCAL=false

# Folders
# Working area for partial downloads and finished MP4s awaiting "Save Video".
# Nothing here is permanent: your browser saves the final file.
# MEDIALAB_TEMP_DIR=/tmp/medialab                    (default: system temp dir /medialab)
# Where settings.json (GUI settings) is stored.
# MEDIALAB_CONFIG_DIR=~/Library/Application Support/MediaLab   (default on macOS)
# Note: MEDIALAB_DOWNLOAD_DIR (v1.0/v1.1) is no longer used.

# Temporary files: finished videos you don't save are deleted after this many minutes.
MEDIALAB_DELIVERY_RETENTION_MINUTES=30
# Disk space always kept free; downloads needing more are refused up front.
MEDIALAB_MIN_FREE_SPACE_MB=512

# Limits
# Also caps Short Drama batch parallelism (a batch runs 1 episode at a time by default, at most 2).
MEDIALAB_MAX_CONCURRENT_DOWNLOADS=2
MEDIALAB_MAX_QUEUED_JOBS=10
MEDIALAB_MAX_CONCURRENT_ANALYSES=4
# Links per X / TikTok bulk download (at most 100).
MEDIALAB_MAX_BULK_URLS=50

# Timeouts (seconds)
MEDIALAB_ANALYSIS_TIMEOUT_SECONDS=45
MEDIALAB_DOWNLOAD_TIMEOUT_SECONDS=10800
MEDIALAB_FFMPEG_TIMEOUT_SECONDS=600
MEDIALAB_SOCKET_TIMEOUT_SECONDS=20

# Expiry and cleanup (seconds)
MEDIALAB_ANALYSIS_TTL_SECONDS=3600
MEDIALAB_JOB_TTL_SECONDS=21600
MEDIALAB_TEMP_MAX_AGE_SECONDS=21600
MEDIALAB_CLEANUP_INTERVAL_SECONDS=60

# First-run values for the GUI settings. They are used only until settings are
# saved in the Settings panel; after that settings.json takes precedence.
# FxTwitter fallback (X only): when true and yt-dlp finds no video for an X post,
# the post ID is sent to api.fxtwitter.com. Video files still come from X's CDN.
MEDIALAB_FXTWITTER_FALLBACK=false
# Maximum file size in MB (256–65536), per download / per Short Drama episode.
MEDIALAB_MAX_FILE_SIZE_MB=8192
# Maximum size in MB (256–262144) of one packaged Short Drama batch output (ZIP or merged MP4).
MEDIALAB_BATCH_OUTPUT_MAX_MB=32768

# X media hosts that downloads may come from (comma-separated domain suffixes).
# TikTok's CDN allowlist is fixed in code (see docs/SECURITY.md).
MEDIALAB_MEDIA_HOST_SUFFIXES=twimg.com

# TikTok Short Drama account: there is deliberately no setting for it here. You link your
# own tiktok.com cookies.txt in the app (Settings → TikTok account); it is stored as
# <MEDIALAB_CONFIG_DIR>/tiktok-cookies.txt with owner-only permissions and used only by
# the Short Drama tab. Never put cookies or session tokens in .env.

# FFmpeg binaries (names on PATH or absolute paths). Single downloads never re-encode video;
# audio that Apple players can't play from MP4 (e.g. MP3) is converted to AAC. Merged Short
# Drama MP4s are re-encoded (H.264 + AAC) only when the episodes don't share one format; this
# is bounded by 6 h per merge; checks on long merged files may run as long as the video itself.
MEDIALAB_FFMPEG_PATH=ffmpeg
MEDIALAB_FFPROBE_PATH=ffprobe

# Serve the built frontend (frontend/dist) from the API server
MEDIALAB_SERVE_FRONTEND=true
